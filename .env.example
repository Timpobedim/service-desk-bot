# Токен бота от @BotFather. Хранится только здесь и только на вашей машине: файл .env в .gitignore.
DESK_BOT_TOKEN=123456789:замените-на-свой-токен

# Где хранить заявки
DESK_DB=заявки.sqlite

# Часовой пояс офиса — в нём считаются сроки
DESK_TZ=Europe/Moscow

# Модель необязательна: без неё бот разбирает сообщения правилами.
# none — без модели, ollama — локальная модель, openai — любой сервис с OpenAI-совместимым API
DESK_MODEL=none
DESK_MODEL_NAME=qwen2.5:7b
DESK_MODEL_URL=http://127.0.0.1:11434
# Ключ нужен только для DESK_MODEL=openai
DESK_MODEL_KEY=
